# Loaded by `npm run dev:live` (vite --mode live): the UI talks to the real backend.
# Start the API first, from the repo root: uvicorn backend.main:app --port 8000
# Personal overrides go in .env.live.local (git-ignored). Never put secrets in VITE_* variables:
# they are compiled into the browser bundle.
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:8000/api
