# Copy to .env.local to change these.

# Sprint 1 default: "true" runs the UI on in-browser fake responses (no backend needed).
# Set to "false" to talk to Oğuz's API (uvicorn backend.main:app --reload).
VITE_USE_MOCK=true

# Base URL of the REST API (docs/api-contracts.md).
VITE_API_BASE_URL=http://localhost:8000/api
