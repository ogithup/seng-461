# Copy to .env.local to change these (or use `npm run dev:live`, which reads .env.live).
# VITE_* values end up in the browser bundle: never put secrets or credentials here.

# "true" (default) runs the UI on in-browser fake responses (no backend needed).
# "false" (also 0/no/off) talks to the real API (uvicorn backend.main:app --port 8000).
VITE_USE_MOCK=true

# Base URL of the REST API (docs/api-contracts.md). Must end in /api.
VITE_API_BASE_URL=http://localhost:8000/api
